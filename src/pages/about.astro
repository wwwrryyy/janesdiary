---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { ESSAY_ENTRIES } from '../data/entries';

const consolidatedCitations = Array.from(
  new Set(ESSAY_ENTRIES.flatMap((entry) => entry.worksCitedMLA))
).sort();

const masterBibliographyText = consolidatedCitations.join('\n\n');
---

<BaseLayout
  title="About the Journal"
  description="The editorial manifesto, masthead, critical methodology, and archival mission of Jane's Diary: an independent journal of feminist literature."
  currentPath="/about/"
>
  <!-- 1. ABOUT HERO BAND -->
  <section class="about-hero orb-stage" aria-labelledby="about-heading">
    <div class="ambient-orb ambient-orb--lavender about-hero__orb-1" aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb--mint about-hero__orb-2" aria-hidden="true"></div>

    <div class="container about-hero__inner">
      <nav class="about-breadcrumb no-print" aria-label="Breadcrumb">
        <a href={withBase('/')} class="about-breadcrumb__link">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="about-breadcrumb__current">About the Journal</span>
      </nav>

      <div class="about-hero__header">
        <div>
          <span class="badge-pill">
            <span class="badge-dot badge-dot--lavender" aria-hidden="true"></span>
            Publication Manifesto
          </span>
          <h1 id="about-heading" class="display-xl about-hero__title">
            Scraping back canonical erasures to uncover submerged manuscripts.
          </h1>
          <p class="body-md about-hero__subtitle">
            <strong>Jane’s Diary</strong> is an independent digital journal and cultural archive dedicated to feminist literary criticism, archival recovery, and subversive poetics. Founded and edited by <strong>Shawn Shaibu Cherian</strong>, the publication traces the continuous tradition of women tearing through patriarchal containment—from Romantic gothic revolt to postcolonial subaltern resistance and cyberfeminism.
          </p>
        </div>

        <div class="about-hero__actions no-print">
          <a href={withBase('/blogs/')} class="button-primary">
            Explore All Essays →
          </a>
          <a href={withBase('/contact/')} class="button-outline">
            Editorial Inquiries
          </a>
        </div>
      </div>

      <!-- Journal Pillars Grid -->
      <div class="feature-card journal-overview-card">
        <div class="journal-overview-grid">
          <div class="journal-stat-item">
            <span class="caption-uppercase">Publication</span>
            <p class="title-md">Jane’s Diary</p>
            <span class="caption">Independent Literary Journal</span>
          </div>
          <div class="journal-stat-item">
            <span class="caption-uppercase">Founding Editor</span>
            <p class="title-md">Shawn Shaibu Cherian</p>
            <span class="caption">Essayist &amp; Archival Researcher</span>
          </div>
          <div class="journal-stat-item">
            <span class="caption-uppercase">Editorial Focus</span>
            <p class="title-sm">Feminist Criticism &amp; Cultural Theory</p>
            <span class="caption">1818 to the Contemporary Era</span>
          </div>
          <div class="journal-stat-item">
            <span class="caption-uppercase">Archival Provenance</span>
            <p class="title-sm">Public-Domain Plates &amp; Primary Documents</p>
            <span class="caption">High-Resolution Curated Artifacts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE EDITORIAL MANIFESTO: THE PALIMPSEST PRINCIPLE -->
  <section class="section-band" aria-labelledby="manifesto-heading">
    <div class="container">
      <div class="manifesto-layout">
        <div class="manifesto-sidebar">
          <span class="badge-pill">
            <span class="badge-dot badge-dot--peach" aria-hidden="true"></span>
            Theoretical Foundation
          </span>
          <h2 id="manifesto-heading" class="display-lg manifesto-title">
            The Palimpsest Principle
          </h2>
          <p class="body-sm text-muted">
            Why we read against the grain of the conventional literary canon.
          </p>
        </div>

        <div class="manifesto-content">
          <blockquote class="manifesto-pullquote">
            “The woman writer does not rewrite the male text; she reads it as a palimpsest, uncovering the erased feminine script beneath its patriarchal surfaces.”
          </blockquote>

          <div class="manifesto-prose body-md">
            <p>
              In their monumental 1979 work <em>The Madwoman in the Attic</em>, feminist theorists Sandra Gilbert and Susan Gubar introduced the metaphor of the palimpsest: ancient parchment from which older text was scraped away so new records could be inscribed on top. For centuries, the Western literary canon operated under a similar erasure. Women’s creative vitality, philosophical inquiry, and radical anger were systematically rewritten, dismissed as hysteria, or forced behind masculine pseudonyms.
            </p>
            <p>
              <em>Jane’s Diary</em> takes its name and mission from that submerged history. Named in homage to Jane Eyre, Charlotte Perkins Gilman’s elusive Jane, and the countless women filed under <em>“Anonymous”</em> or <em>“By a Lady,”</em> this journal treats literature not as a static museum of monumental male achievements, but as an ongoing battlefield over who has the right to speak, write, and be remembered.
            </p>
          </div>

          <div class="pillars-grid">
            <div class="feature-card pillar-card">
              <span class="badge-pill">Pillar 01</span>
              <h3 class="title-sm pillar-card__heading">Archival Recovery</h3>
              <p class="body-sm text-body">
                Rescuing historical primary documents, forgotten title pages, and suppressed editions to trace the material conditions under which women authored subversive literature.
              </p>
            </div>

            <div class="feature-card pillar-card">
              <span class="badge-pill">Pillar 02</span>
              <h3 class="title-sm pillar-card__heading">Postcolonial &amp; Subaltern Critique</h3>
              <p class="body-sm text-body">
                Refusing Eurocentric feminist orthodoxies by foregrounding Dalit, indigenous, and Global South women’s literature where state violence and caste hegemony are contested on the terrain of the body.
              </p>
            </div>

            <div class="feature-card pillar-card">
              <span class="badge-pill">Pillar 03</span>
              <h3 class="title-sm pillar-card__heading">Archival Recovery &amp; Pedagogy</h3>
              <p class="body-sm text-body">
                Curating high-resolution primary facsimiles in The Palimpsest Archive and developing structured university seminar tracks that transform static literature into active instruments of decolonial thought.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CLIENT SERVICES & EDITORIAL COMMISSIONS -->
  <section class="section-band section-band--soft" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <span class="badge-pill">
          <span class="badge-dot badge-dot--sky" aria-hidden="true"></span>
          Collaboration &amp; Commissions
        </span>
        <h2 id="services-heading" class="display-lg section-title">
          Editorial Services for Cultural Institutions &amp; Clients
        </h2>
        <p class="body-md section-lead">
          In addition to publishing regular dispatches, <em>Jane’s Diary</em> collaborates with cultural organizations, academic journals, creative agencies, and independent publications.
        </p>
      </div>

      <div class="services-grid">
        <div class="feature-card service-card">
          <div class="service-card__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="title-md service-card__title">Commissioned Long-Form Essays</h3>
          <p class="body-sm text-body">
            Deeply researched critical essays, literary reviews, and cultural think-pieces examining gender, contemporary media, and feminist intellectual history.
          </p>
          <ul class="service-card__list body-sm">
            <li>Exhibition catalog essays and critical introductions</li>
            <li>Book reviews and author retrospectives</li>
            <li>Thematic cultural journalism and think-pieces</li>
          </ul>
        </div>

        <div class="feature-card service-card">
          <div class="service-card__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V2H6.5A2.5 2.5 0 004 4.5v15z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="title-md service-card__title">Archival Research &amp; Curation</h3>
          <p class="body-sm text-body">
            Archival investigations into nineteenth- and twentieth-century women's manuscripts, pseudonym tracking, and open-access rights clearing.
          </p>
          <ul class="service-card__list body-sm">
            <li>Rare text digitization and transcriptions</li>
            <li>Provenance verification for historical plates</li>
            <li>Bibliographic indexing in MLA 9th and Chicago styles</li>
          </ul>
        </div>

        <div class="feature-card service-card">
          <div class="service-card__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="title-md service-card__title">Lectures, Seminars &amp; Panels</h3>
          <p class="body-sm text-body">
            Engaging keynote lectures and seminar facilitation on feminist speculative fiction, the history of censorship, and digital humanities.
          </p>
          <ul class="service-card__list body-sm">
            <li>Guest lectures for university literature departments</li>
            <li>Panel moderation for literary festivals</li>
            <li>Interactive digital humanities workshops</li>
          </ul>
        </div>
      </div>

      <div class="services-cta-banner">
        <div>
          <h3 class="title-md">Have an upcoming editorial project or commission?</h3>
          <p class="body-sm text-muted">We welcome inquiries from publishers, cultural curators, and independent clients.</p>
        </div>
        <a href={withBase('/contact/')} class="button-primary">
          Contact the Editorial Desk →
        </a>
      </div>
    </div>
  </section>

  <!-- 4. MASTER SCHOLARLY BIBLIOGRAPHY -->
  <section id="bibliography" class="section-band" aria-labelledby="bib-heading">
    <div class="container">
      <div class="feature-card master-bib-card">
        <div class="master-bib-card__header">
          <div>
            <span class="badge-pill">Archival Bibliography · MLA 9th Edition</span>
            <h2 id="bib-heading" class="display-md master-bib-card__title">
              Consolidated Scholarly References
            </h2>
            <p class="body-sm text-muted">
              Complete academic citations for all primary literary texts and critical theoretical frameworks analyzed across <em>Jane’s Diary</em>.
            </p>
          </div>

          <button
            type="button"
            id="copy-master-bib-btn"
            class="button-primary no-print"
            data-bib={masterBibliographyText}
          >
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <path d="M10.5 5.5V3.5C10.5 2.67157 9.82843 2 9 2H3.5C2.67157 2 2 2.67157 2 3.5V9C2 9.82843 2.67157 10.5 3.5 10.5H5.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
            <span id="copy-master-bib-label">Copy All Citations (MLA 9th)</span>
          </button>
        </div>

        <div class="works-cited-list">
          {consolidatedCitations.map((citation) => (
            <p class="mla-hanging-indent">{citation}</p>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initMasterBibCopy() {
    const copyBtn = document.getElementById('copy-master-bib-btn');
    const copyLabel = document.getElementById('copy-master-bib-label');
    if (!copyBtn || !copyLabel) return;

    copyBtn.addEventListener('click', async () => {
      const bibText = copyBtn.getAttribute('data-bib') || '';
      try {
        await navigator.clipboard.writeText(bibText);
        copyLabel.textContent = 'All Citations Copied to Clipboard';
        setTimeout(() => {
          copyLabel.textContent = 'Copy All Citations (MLA 9th)';
        }, 2500);
      } catch {
        copyLabel.textContent = 'Select Text Below to Copy';
      }
    });
  }

  initMasterBibCopy();
</script>

<style>
  .about-hero {
    padding: 64px 0 48px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .about-hero__orb-1 {
    width: 320px;
    height: 320px;
    top: -80px;
    right: 5%;
  }

  .about-hero__orb-2 {
    width: 260px;
    height: 260px;
    top: 40px;
    left: -40px;
  }

  .about-hero__inner {
    position: relative;
    z-index: 1;
  }

  .about-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 13px;
    color: var(--color-muted);
    margin-bottom: var(--space-lg);
  }

  .about-breadcrumb__link {
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .about-breadcrumb__link:hover {
    color: var(--color-ink);
  }

  .about-breadcrumb__current {
    color: var(--color-ink);
    font-weight: 500;
  }

  .about-hero__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .about-hero__header > div:first-child {
    max-width: 820px;
  }

  .about-hero__title {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-base);
  }

  .about-hero__subtitle {
    color: var(--color-body);
    line-height: 1.6;
  }

  .about-hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding-top: var(--space-base);
  }

  /* Journal Overview Card */
  .journal-overview-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
  }

  .journal-overview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .journal-stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Manifesto Section */
  .manifesto-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-xxl);
    align-items: start;
  }

  .manifesto-title {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .manifesto-pullquote {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 300;
    line-height: 1.35;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft);
    border-left: 3px solid var(--color-ink);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: var(--space-lg) var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .manifesto-prose p {
    margin-bottom: var(--space-base);
    line-height: 1.65;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-base);
    margin-top: var(--space-xl);
  }

  .pillar-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .pillar-card__heading {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-xxl);
  }

  .service-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .service-card__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-strong);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-base);
  }

  .service-card__title {
    margin-bottom: var(--space-xs);
  }

  .service-card__list {
    margin-top: var(--space-base);
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--color-muted);
  }

  .services-cta-banner {
    background-color: var(--color-surface-dark);
    color: var(--color-on-primary);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-xxl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .services-cta-banner h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 300;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .services-cta-banner p {
    color: #a8a29e;
  }

  .services-cta-banner .button-primary {
    background-color: #ffffff;
    color: #0c0a09;
  }

  .services-cta-banner .button-primary:hover {
    background-color: #f0efed;
  }

  /* Master Bibliography */
  .master-bib-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
  }

  .master-bib-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-base);
    border-bottom: 1px solid var(--color-hairline);
  }

  .master-bib-card__title {
    margin-top: var(--space-xs);
    margin-bottom: 4px;
  }

  .works-cited-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-base);
  }

  .mla-hanging-indent {
    padding-left: 32px;
    text-indent: -32px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-body);
  }

  @media (max-width: 1024px) {
    .journal-overview-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .manifesto-layout {
      grid-template-columns: 1fr;
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .journal-overview-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
