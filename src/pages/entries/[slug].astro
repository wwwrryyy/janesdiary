---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { ESSAY_ENTRIES, type EssayEntry } from '../../data/entries';

export function getStaticPaths() {
  return ESSAY_ENTRIES.map((entry, index) => {
    const prevEntry = index > 0 ? ESSAY_ENTRIES[index - 1] : ESSAY_ENTRIES[ESSAY_ENTRIES.length - 1];
    const nextEntry = index < ESSAY_ENTRIES.length - 1 ? ESSAY_ENTRIES[index + 1] : ESSAY_ENTRIES[0];
    return {
      params: { slug: entry.slug },
      props: { entry, prevEntry, nextEntry },
    };
  });
}

interface Props {
  entry: EssayEntry;
  prevEntry: EssayEntry;
  nextEntry: EssayEntry;
}

const { entry, prevEntry, nextEntry } = Astro.props;

// Load the corresponding essay Markdown file from src/content/essays/<slug>.md
const markdownFiles = import.meta.glob('../../content/essays/*.md', { eager: true });
const mdKey = `../../content/essays/${entry.slug}.md`;
const mdModule = markdownFiles[mdKey] as { Content?: any } | undefined;
const MarkdownContent = mdModule?.Content;

const essayCitation = `Cherian, Shawn Shaibu. "${entry.title}." Jane's Diary: A Journal of Feminist Literature & Archival Studies, Oct. 2026, https://wwwrryyy.github.io/janesdiary/entries/${entry.slug}/.`;
const allCitationsText = [essayCitation, ...entry.worksCitedMLA].join('\n\n');
---

<BaseLayout
  title={`${entry.title} — Jane's Diary`}
  description={entry.subtitle}
  currentPath={`/entries/${entry.slug}/`}
>
  <!-- 1. ENTRY HEADER BAND -->
  <section class="entry-hero orb-stage" aria-labelledby="entry-title">
    <div class={`ambient-orb ambient-orb--${entry.orb} entry-hero__orb-primary`} aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb--peach entry-hero__orb-secondary" aria-hidden="true"></div>

    <div class="container entry-hero__inner">
      <nav class="entry-breadcrumb" aria-label="Breadcrumb">
        <a href={withBase('/')} class="entry-breadcrumb__link">Home</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/blogs/')} class="entry-breadcrumb__link">Essays</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="entry-breadcrumb__current">Essay {entry.number}</span>
      </nav>

      <div class="entry-hero__badges">
        <span class="badge-pill">
          <span class={`badge-dot badge-dot--${entry.orb}`} aria-hidden="true"></span>
          Essay {entry.number}
        </span>
        <span class="badge-pill">{entry.subsection}</span>
        <span class="caption">{entry.readingTime} · By Shawn Shaibu Cherian</span>
      </div>

      <h1 id="entry-title" class="display-xl entry-hero__title">
        {entry.title}
      </h1>

      <p class="title-md entry-hero__subtitle">
        {entry.subtitle}
      </p>

      <!-- Primary Works Metadata Cards -->
      <div class="works-cards" aria-label="Primary Literary Works Analyzed">
        {entry.primaryWorks.map((work) => (
          <div class="feature-card work-meta-card">
            <div class="work-meta-card__top">
              <span class="caption-uppercase work-meta-card__tag">Primary Text ({work.year})</span>
              <span class="badge-pill">{work.copyrightStatus}</span>
            </div>
            <h2 class="display-sm work-meta-card__title">
              <em>{work.title}</em>
            </h2>
            <p class="body-sm work-meta-card__author">
              {work.author}
              {work.translatorOrNote ? ` · ${work.translatorOrNote}` : ''}
            </p>
          </div>
        ))}
      </div>

      <!-- Archival Portrait & Historical Material Gallery -->
      <div class="entry-archival-hero">
        <div class="feature-card archival-hero-card">
          <div class="archival-hero-card__grid">
            <div class="archival-hero-card__frame">
              <img
                src={withBase(entry.archivalImage.src)}
                alt={entry.archivalImage.alt}
                class="archival-hero-card__img"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="archival-hero-card__info">
              <div class="badge-pill">
                <span class={`badge-dot badge-dot--${entry.orb}`} aria-hidden="true"></span>
                Archival Plate · {entry.subsection}
              </div>
              <blockquote class="archival-hero-card__caption">
                {entry.archivalImage.caption}
              </blockquote>
              <p class="caption text-muted archival-hero-card__credit">
                <strong>Source:</strong> {entry.archivalImage.credit}
              </p>

              {entry.archivalImage.secondarySrc && (
                <div class="archival-hero-card__secondary">
                  <div class="archival-hero-card__secondary-frame">
                    <img
                      src={withBase(entry.archivalImage.secondarySrc)}
                      alt={entry.archivalImage.secondaryAlt || 'Historical document plate'}
                      class="archival-hero-card__secondary-img"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <p class="caption text-body">
                    <strong>Primary Artifact:</strong> {entry.archivalImage.secondaryCaption}
                  </p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- 3. ESSAY BODY & INTERACTIVE CRITICAL LENS PASSAGES -->
  <section class="section-band entry-body-band">
    <div class="container entry-layout">
      <!-- Left / Main Editorial Column -->
      <div class="entry-main" id="readable-essay-container">
        <!-- Editorial Abstract Card -->
        <div class="gradient-orb-card entry-abstract-card">
          <div class={`ambient-orb ambient-orb--${entry.orb} entry-abstract-card__orb`} aria-hidden="true"></div>
          <div class="entry-abstract-card__inner">
            <span class="caption-uppercase">Editorial Framing · Essay {entry.number}</span>
            <p class="display-sm entry-abstract-card__text">
              {entry.editorialAbstract}
            </p>
          </div>
        </div>

        <!-- Full Published Essay Prose -->
        <article class="essay-article-body">
          <div class="markdown-prose">
            {MarkdownContent && <MarkdownContent />}
          </div>
        </article>

        <!-- Author Bio Card -->
        <div class="feature-card author-bio-card">
          <div class="author-bio-card__avatar" aria-hidden="true">SC</div>
          <div class="author-bio-card__content">
            <span class="caption-uppercase author-bio-card__eyebrow">Written by</span>
            <h3 class="display-xs author-bio-card__name">Shawn Shaibu Cherian</h3>
            <p class="body-sm author-bio-card__bio">
              Literary essayist, researcher, and founding editor of <em>Jane’s Diary</em>. His critical work explores the intersections of feminist theory, postcolonial subalternity, Victorian gothic confinement, and archival recovery.
            </p>
            <div class="author-bio-card__actions">
              <a href={withBase('/contact/')} class="button-outline">
                Commission an Essay or Inquire →
              </a>
              <a href={withBase('/about/')} class="button-tertiary">
                Read Publication Manifesto
              </a>
            </div>
          </div>
        </div>

        <!-- MLA 9TH WORKS CITED BOX -->
        <div id="works-cited" class="feature-card works-cited-card">
          <div class="works-cited-card__header">
            <div>
              <span class="badge-pill">Scholarly Bibliography</span>
              <h2 class="display-sm works-cited-card__title">
                MLA 9th Edition Works Cited
              </h2>
            </div>
            <button
              type="button"
              id="copy-mla-btn"
              class="button-primary"
              data-citations={allCitationsText}
            >
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
                <path d="M10.5 5.5V3.5C10.5 2.67157 9.82843 2 9 2H3.5C2.67157 2 2 2.67157 2 3.5V9C2 9.82843 2.67157 10.5 3.5 10.5H5.5" stroke="currentColor" stroke-width="1.4"/>
              </svg>
              <span id="copy-mla-label">Copy MLA Citations</span>
            </button>
          </div>

          <div class="works-cited-list">
            <p class="mla-hanging-indent">
              {essayCitation}
            </p>
            {entry.worksCitedMLA.map((citation) => (
              <p class="mla-hanging-indent">{citation}</p>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Sidebar: Editorial Profile & Archive -->
      <aside class="entry-sidebar" aria-label="Editorial Details and Issue Directory">
        <div class="feature-card sidebar-card">
          <span class="caption-uppercase sidebar-card__heading">Publication Details</span>
          <p class="title-sm sidebar-card__name">Jane’s Diary</p>
          <p class="caption">An Independent Journal of Feminist Literature</p>
          <p class="caption">Edited by Shawn Shaibu Cherian</p>
          <hr class="sidebar-divider" />
          <span class="caption-uppercase sidebar-card__heading">Client &amp; Editorial Inquiries</span>
          <p class="body-sm sidebar-card__note">
            Available for cultural writing commissions, literary essays, guest lectures, and archival collaborations.
          </p>
          <div class="sidebar-card__actions">
            <a href={withBase('/contact/')} class="button-primary sidebar-btn">
              Contact Editorial Desk
            </a>
            <a href={withBase('/archive/')} class="button-outline sidebar-btn">
              The Palimpsest Archive
            </a>
          </div>
        </div>

        <div class="feature-card sidebar-card">
          <span class="caption-uppercase sidebar-card__heading">All 8 Cornerstone Essays</span>
          <ul class="sidebar-entry-list">
            {ESSAY_ENTRIES.map((item) => (
              <li>
                <a
                  href={withBase(`/entries/${item.slug}/`)}
                  class:list={['sidebar-entry-link', { 'is-current': item.slug === entry.slug }]}
                >
                  <span class="sidebar-entry-num">{item.number}</span>
                  <span>{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- 5. PREVIOUS / NEXT ENTRY NAVIGATION CARDS -->
  <section class="section-band section-band--soft entry-pager" aria-label="Entry Pagination">
    <div class="container">
      <div class="pager-grid">
        <a href={withBase(`/entries/${prevEntry.slug}/`)} class="feature-card pager-card">
          <span class="caption-uppercase pager-card__dir">← Previous Entry ({prevEntry.number})</span>
          <span class="display-sm pager-card__title">{prevEntry.title}</span>
          <span class="caption">{prevEntry.era}</span>
        </a>

        <a href={withBase(`/entries/${nextEntry.slug}/`)} class="feature-card pager-card pager-card--next">
          <span class="caption-uppercase pager-card__dir">Next Entry ({nextEntry.number}) →</span>
          <span class="display-sm pager-card__title">{nextEntry.title}</span>
          <span class="caption">{nextEntry.era}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // MLA CITATION COPY CONTROLLER
  function initCitationCopy() {
    const copyBtn = document.getElementById('copy-mla-btn');
    const copyLabel = document.getElementById('copy-mla-label');
    if (!copyBtn || !copyLabel) return;

    copyBtn.addEventListener('click', async () => {
      const citations = copyBtn.getAttribute('data-citations') || '';
      try {
        await navigator.clipboard.writeText(citations);
        copyLabel.textContent = 'Copied MLA 9th to Clipboard';
        setTimeout(() => {
          copyLabel.textContent = 'Copy MLA Citations';
        }, 2400);
      } catch {
        copyLabel.textContent = 'Select Text Below to Copy';
      }
    });
  }

  initCitationCopy();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* 1. Entry Hero */
  .entry-hero {
    padding: 64px 0 48px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .entry-hero__orb-primary {
    width: 420px;
    height: 420px;
    top: -100px;
    right: 8%;
  }

  .entry-hero__orb-secondary {
    width: 300px;
    height: 300px;
    bottom: -80px;
    left: 5%;
    opacity: 0.35;
  }

  .entry-hero__inner {
    position: relative;
    z-index: 1;
  }

  .entry-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-muted);
    margin-bottom: var(--space-lg);
  }

  .entry-breadcrumb__link:hover {
    color: var(--color-ink);
  }

  .entry-breadcrumb__current {
    color: var(--color-ink);
    font-weight: 500;
  }

  .entry-hero__badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-base);
  }

  .entry-hero__title {
    max-width: 900px;
    margin-bottom: var(--space-base);
  }

  .entry-hero__subtitle {
    max-width: 780px;
    color: var(--color-body);
    font-weight: 400;
    margin-bottom: var(--space-xl);
  }

  .works-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-base);
  }

  .work-meta-card {
    padding: var(--space-base) var(--space-lg);
  }

  .work-meta-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .work-meta-card__tag {
    color: var(--color-muted);
  }

  .work-meta-card__title {
    margin-bottom: 4px;
  }

  /* Archival Hero Card Showcase */
  .entry-archival-hero {
    margin-top: var(--space-xl);
  }

  .archival-hero-card {
    padding: var(--space-xl);
  }

  .archival-hero-card__grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .archival-hero-card__frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface-strong);
    border: 1px solid var(--color-hairline);
    aspect-ratio: 4 / 5;
  }

  .archival-hero-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: sepia(10%) contrast(102%);
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .archival-hero-card:hover .archival-hero-card__img {
    transform: scale(1.02);
    filter: sepia(0%) contrast(105%);
  }

  .archival-hero-card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .archival-hero-card__caption {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-ink);
    margin: 8px 0;
    padding-left: 16px;
    border-left: 2px solid var(--color-primary);
  }

  .archival-hero-card__credit {
    font-size: 12px;
  }

  .archival-hero-card__secondary {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed var(--color-hairline);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .archival-hero-card__secondary-frame {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    flex-shrink: 0;
  }

  .archival-hero-card__secondary-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .archival-hero-card__grid {
      grid-template-columns: 1fr;
    }

    .archival-hero-card__frame {
      aspect-ratio: 16 / 9;
      max-height: 240px;
    }
  }



  /* 3. Main Entry Layout */
  .entry-body-band {
    padding-top: var(--space-xxl);
  }

  .entry-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-xxl);
    align-items: start;
  }

  .entry-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
  }


  .entry-abstract-card__orb {
    width: 240px;
    height: 240px;
    top: -60px;
    right: -40px;
  }

  .entry-abstract-card__inner {
    position: relative;
    z-index: 1;
  }

  .entry-abstract-card__text {
    margin-top: var(--space-xs);
  }


  .markdown-prose {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    margin-bottom: var(--space-lg);
  }

  .markdown-prose :global(h2) {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-ink);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .markdown-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .markdown-prose :global(p) {
    margin-bottom: var(--space-base);
    color: var(--color-body);
  }

  .markdown-prose :global(blockquote) {
    background-color: var(--color-canvas-soft);
    border-left: 3px solid var(--color-ink);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-base) var(--space-lg);
    margin: var(--space-base) 0 var(--space-lg);
  }

  .markdown-prose :global(ul) {
    padding-left: var(--space-lg);
    margin-top: var(--space-xs);
  }

  .markdown-prose :global(li) {
    margin-bottom: 6px;
  }

  .markdown-prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    background-color: var(--color-surface-strong);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  .essay-article-body {
    width: 100%;
  }

  .author-bio-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    margin: var(--space-xl) 0;
  }

  .author-bio-card__avatar {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    background-color: var(--color-ink);
    color: var(--color-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 400;
    flex-shrink: 0;
  }

  .author-bio-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .author-bio-card__name {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 300;
    color: var(--color-ink);
  }

  .author-bio-card__bio {
    color: var(--color-body);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .author-bio-card__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }



  /* Works Cited Card */
  .works-cited-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-base);
    border-bottom: 1px solid var(--color-hairline);
  }

  .works-cited-card__title {
    margin-top: 6px;
  }

  .works-cited-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mla-hanging-indent {
    padding-left: 32px;
    text-indent: -32px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink);
  }

  /* Sidebar */
  .entry-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: sticky;
    top: 240px;
  }

  .sidebar-card__heading {
    display: block;
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .sidebar-card__name {
    margin-bottom: 2px;
  }

  .sidebar-divider {
    border: 0;
    border-top: 1px solid var(--color-hairline);
    margin: var(--space-base) 0;
  }

  .sidebar-card__note {
    margin-bottom: var(--space-base);
  }

  .sidebar-card__note code {
    font-size: 12px;
    background-color: var(--color-surface-strong);
    padding: 2px 5px;
    border-radius: 4px;
  }

  .sidebar-card__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .sidebar-btn {
    width: 100%;
  }

  .sidebar-entry-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .sidebar-entry-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: 14px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    color: var(--color-body);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .sidebar-entry-link:hover,
  .sidebar-entry-link.is-current {
    background-color: var(--color-surface-strong);
    color: var(--color-ink);
    font-weight: 500;
  }

  .sidebar-entry-num {
    font-size: 12px;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Entry Pager */
  .pager-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .pager-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pager-card--next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-card__dir {
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .entry-layout {
      grid-template-columns: 1fr;
    }
    .entry-sidebar {
      position: static;
    }
    .reading-controls-band {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .pager-grid {
      grid-template-columns: 1fr;
    }
    .pager-card--next {
      text-align: left;
      align-items: flex-start;
    }
    .markdown-prose {
      padding: var(--space-lg);
    }
  }
</style>
