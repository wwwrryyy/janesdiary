---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { ESSAY_ENTRIES, type EssayEntry } from '../../data/entries';

export function getStaticPaths() {
  return ESSAY_ENTRIES.map((entry, index) => {
    const prevEntry = index > 0 ? ESSAY_ENTRIES[index - 1] : ESSAY_ENTRIES[ESSAY_ENTRIES.length - 1];
    const nextEntry = index < ESSAY_ENTRIES.length - 1 ? ESSAY_ENTRIES[index + 1] : ESSAY_ENTRIES[0];
    return {
      params: { slug: entry.slug },
      props: { entry, prevEntry, nextEntry },
    };
  });
}

interface Props {
  entry: EssayEntry;
  prevEntry: EssayEntry;
  nextEntry: EssayEntry;
}

const { entry, prevEntry, nextEntry } = Astro.props;

// Load the corresponding student Markdown file from src/content/essays/<slug>.md
const markdownFiles = import.meta.glob('../../content/essays/*.md', { eager: true });
const mdKey = `../../content/essays/${entry.slug}.md`;
const mdModule = markdownFiles[mdKey] as { Content?: any } | undefined;
const MarkdownContent = mdModule?.Content;

const studentEssayCitation = `Cherian, Shawn Shaibu. "${entry.title}." Jane's Diary: An Interactive Archive of Feminist Literature, 19 Oct. 2026, https://wwwrryyy.github.io/janesdiary/entries/${entry.slug}/.`;
const allCitationsText = [studentEssayCitation, ...entry.worksCitedMLA].join('\n\n');
---

<BaseLayout
  title={`Entry ${entry.number}: ${entry.title}`}
  description={entry.subtitle}
  currentPath={`/entries/${entry.slug}/`}
>
  <!-- 1. ENTRY HEADER BAND -->
  <section class="entry-hero orb-stage" aria-labelledby="entry-title">
    <div class={`ambient-orb ambient-orb--${entry.orb} entry-hero__orb-primary`} aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb--peach entry-hero__orb-secondary" aria-hidden="true"></div>

    <div class="container entry-hero__inner">
      <nav class="entry-breadcrumb" aria-label="Breadcrumb">
        <a href={withBase('/')} class="entry-breadcrumb__link">Home</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/#entries')} class="entry-breadcrumb__link">Entries</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="entry-breadcrumb__current">Entry {entry.number}</span>
      </nav>

      <div class="entry-hero__badges">
        <span class="badge-pill">
          <span class={`badge-dot badge-dot--${entry.orb}`} aria-hidden="true"></span>
          Entry No. {entry.number}
        </span>
        <span class="badge-pill">{entry.era}</span>
        <span class="caption">{entry.readingTime} · Shawn Shaibu Cherian (26BCE1820)</span>
      </div>

      <h1 id="entry-title" class="display-xl entry-hero__title">
        {entry.title}
      </h1>

      <p class="title-md entry-hero__subtitle">
        {entry.subtitle}
      </p>

      <!-- Primary Works Metadata Cards -->
      <div class="works-cards" aria-label="Primary Literary Works Analyzed">
        {entry.primaryWorks.map((work) => (
          <div class="feature-card work-meta-card">
            <div class="work-meta-card__top">
              <span class="caption-uppercase work-meta-card__tag">Primary Text ({work.year})</span>
              <span class="badge-pill">{work.copyrightStatus}</span>
            </div>
            <h2 class="display-sm work-meta-card__title">
              <em>{work.title}</em>
            </h2>
            <p class="body-sm work-meta-card__author">
              {work.author}
              {work.translatorOrNote ? ` · ${work.translatorOrNote}` : ''}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. STICKY READING TOOLBAR + ELEVENLABS VOICE BAR -->
  <section class="reading-controls-band no-print" aria-label="Interactive Reading Controls">
    <div class="container">
      <!-- ElevenLabs Signature Audio Waveform Card -->
      <div id="voice-player" class="audio-waveform-card voice-player">
        <div class="voice-player__header">
          <div class="voice-player__identity">
            <div class="voice-icon-circular" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 2V14M5 5V11M11 4V12M2 7V9M14 6.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <div class="voice-player__title-row">
                <span class="body-strong">ElevenLabs Editorial Read-Aloud</span>
                <span class="badge-pill" id="voice-status-badge">Ready</span>
              </div>
              <p class="caption" id="voice-progress-label">
                Reads the entry abstract, essay sections, and active Critical Lens passages aloud via Web Speech synthesis.
              </p>
            </div>
          </div>

          <!-- Animated SVG Waveform Bars -->
          <div class="voice-waveform" id="voice-waveform" data-playing="false" aria-hidden="true">
            {Array.from({ length: 28 }).map((_, i) => (
              <span
                class="voice-waveform__bar"
                style={`--bar-index: ${i}; --bar-height: ${28 + ((i * 19) % 65)}%`}
              />
            ))}
          </div>
        </div>

        <div class="voice-player__controls">
          <div class="voice-player__buttons">
            <button type="button" id="voice-play-btn" class="button-primary">
              <svg id="voice-play-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3.5 2.5L11.5 7L3.5 11.5V2.5Z" fill="currentColor"/>
              </svg>
              <span id="voice-play-label">Listen to Entry</span>
            </button>
            <button type="button" id="voice-stop-btn" class="button-outline" disabled>
              Stop
            </button>
          </div>

          <div class="voice-player__settings">
            <div class="voice-speed-group" role="group" aria-label="Playback Speed">
              {[0.75, 1, 1.25, 1.5].map((rate) => (
                <button
                  type="button"
                  class="button-outline voice-speed-pill"
                  data-speech-rate={rate}
                  aria-pressed={rate === 1 ? 'true' : 'false'}
                >
                  {rate}x
                </button>
              ))}
            </div>

            <div class="voice-select-wrap">
              <label for="voice-selector" class="sr-only">Select Voice</label>
              <select id="voice-selector" class="text-input voice-select" aria-label="Speech Synthesis Voice">
                <option value="">Default System Editorial Voice</option>
              </select>
            </div>
          </div>
        </div>

        <p id="voice-fallback-msg" class="caption voice-player__fallback" hidden>
          Web Speech API synthesis is not available in this browser environment. You can still explore all interactive Critical Lens passages below.
        </p>
      </div>

      <!-- Sticky Global Critical Lens Switch Bar -->
      <div class="sticky-lens-bar" id="critical-lens">
        <div class="sticky-lens-bar__info">
          <span class="badge-pill">
            <span class={`badge-dot badge-dot--${entry.orb}`} aria-hidden="true"></span>
            Subtext X-Ray
          </span>
          <span class="body-sm sticky-lens-bar__text">
            Global Critical Lens Mode: <strong id="global-lens-state-label">Surface Text</strong>
          </span>
        </div>

        <div class="sticky-lens-bar__controls">
          <button
            type="button"
            id="global-lens-switch"
            class="lens-switch-pill"
            role="switch"
            aria-checked="false"
            aria-label="Toggle all passages between Surface Text and Critical Lens Subtext"
          >
            <span class="lens-switch-pill__option is-selected" data-lens-opt="surface">
              Surface Text
            </span>
            <span class="lens-switch-pill__option" data-lens-opt="subtext">
              Critical Lens (Subtext)
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. ESSAY BODY & INTERACTIVE CRITICAL LENS PASSAGES -->
  <section class="section-band entry-body-band">
    <div class="container entry-layout">
      <!-- Left / Main Editorial Column -->
      <div class="entry-main" id="readable-essay-container">
        <!-- Editorial Abstract Card -->
        <div class="gradient-orb-card entry-abstract-card" data-speech-segment="Abstract">
          <div class={`ambient-orb ambient-orb--${entry.orb} entry-abstract-card__orb`} aria-hidden="true"></div>
          <div class="entry-abstract-card__inner">
            <span class="caption-uppercase">Editorial Framing · Entry {entry.number}</span>
            <p class="display-sm entry-abstract-card__text">
              {entry.editorialAbstract}
            </p>
          </div>
        </div>

        <!-- Student Essay Prose (Compiled from src/content/essays/<slug>.md) -->
        <div class="essay-markdown-section">
          <div class="essay-markdown-header">
            <div>
              <span class="badge-pill">Author’s Manuscript · Editable Markdown</span>
              <h2 class="display-md essay-markdown-title">
                Essay Body &amp; Analytical Sections
              </h2>
            </div>
            <span class="caption">
              Source: <code>src/content/essays/{entry.slug}.md</code>
            </span>
          </div>

          <div class="markdown-prose" data-speech-segment="Author Essay Prose">
            {MarkdownContent && <MarkdownContent />}
          </div>

          <!-- Structured Section Prompts Reference Grid -->
          <div class="section-blueprints">
            {entry.sections.map((sec) => (
              <div class="feature-card blueprint-card" data-speech-segment={`Section ${sec.numeral}: ${sec.heading}`}>
                <div class="blueprint-card__top">
                  <span class="badge-pill">Section {sec.numeral}</span>
                  <span class="caption">Target length: {sec.suggestedWords}</span>
                </div>
                <h3 class="title-md blueprint-card__heading">{sec.heading}</h3>
                <p class="body-sm blueprint-card__placeholder">{sec.promptPlaceholder}</p>
                <ul class="blueprint-card__list">
                  {sec.guidingPoints.map((pt) => (
                    <li class="body-sm">{pt}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <!-- Interactive Critical Lens Passages -->
        <div class="critical-lens-section" aria-labelledby="lens-section-heading">
          <div class="critical-lens-section__header">
            <span class="badge-pill">
              <span class={`badge-dot badge-dot--${entry.orb}`} aria-hidden="true"></span>
              Interactive Text X-Ray
            </span>
            <h2 id="lens-section-heading" class="display-md critical-lens-section__title">
              Critical Lens Passages: Surface vs. Subtext
            </h2>
            <p class="body-sm critical-lens-section__desc">
              Public-domain works display verbatim historical quotations on the <strong>Surface Text</strong> tab. Copyrighted works provide structured fair-use quotation slots alongside subtextual analysis prompts. Use the global switch above or toggle individual passages below.
            </p>
          </div>

          <div class="lens-cards-stack">
            {entry.criticalLensPassages.map((passage) => (
              <article
                class="feature-card lens-card"
                data-lens-card
                data-speech-segment={`Passage ${passage.passageNumber} from ${passage.workTitle}`}
              >
                <div class="lens-card__top">
                  <div class="lens-card__meta">
                    <span class="badge-pill">Passage {passage.passageNumber}</span>
                    <span class="caption">{passage.contextLabel}</span>
                  </div>

                  <div class="lens-card__tabs" role="group" aria-label={`View mode for Passage ${passage.passageNumber}`}>
                    <button
                      type="button"
                      class="button-outline lens-tab-btn is-active"
                      data-lens-tab="surface"
                      aria-pressed="true"
                    >
                      Surface Text
                    </button>
                    <button
                      type="button"
                      class="button-outline lens-tab-btn"
                      data-lens-tab="subtext"
                      aria-pressed="false"
                    >
                      Critical Lens (Subtext)
                    </button>
                  </div>
                </div>

                <h3 class="title-sm lens-card__work">
                  <em>{passage.workTitle}</em> — {passage.author} ({passage.year})
                </h3>

                <!-- Surface Tab Content -->
                <div class="lens-card__pane lens-card__pane--surface" data-lens-pane="surface">
                  <blockquote class:list={['lens-quote', { 'lens-quote--placeholder': !passage.isPublicDomain }]}>
                    {passage.surfaceQuote}
                  </blockquote>
                  <p class="caption lens-card__citation">
                    <strong>Source:</strong> {passage.surfaceCitation}
                  </p>
                </div>

                <!-- Critical Lens (Subtext) Tab Content -->
                <div class="lens-card__pane lens-card__pane--subtext" data-lens-pane="subtext" hidden>
                  <div class="subtext-box">
                    <span class="caption-uppercase subtext-box__eyebrow">
                      Feminist &amp; Psychoanalytic Subtext Prompt
                    </span>
                    <p class="body-md subtext-box__prompt">
                      {passage.criticalLensPrompt}
                    </p>
                    <div class="subtext-box__question">
                      <span class="caption-uppercase">Guiding Seminar Question:</span>
                      <p class="body-sm">{passage.guidingQuestion}</p>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- 4. MLA 9TH WORKS CITED BOX -->
        <div id="works-cited" class="feature-card works-cited-card">
          <div class="works-cited-card__header">
            <div>
              <span class="badge-pill">Academic Bibliography</span>
              <h2 class="display-sm works-cited-card__title">
                MLA 9th Edition Works Cited
              </h2>
            </div>
            <button
              type="button"
              id="copy-mla-btn"
              class="button-primary"
              data-citations={allCitationsText}
            >
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
                <path d="M10.5 5.5V3.5C10.5 2.67157 9.82843 2 9 2H3.5C2.67157 2 2 2.67157 2 3.5V9C2 9.82843 2.67157 10.5 3.5 10.5H5.5" stroke="currentColor" stroke-width="1.4"/>
              </svg>
              <span id="copy-mla-label">Copy MLA Citations</span>
            </button>
          </div>

          <div class="works-cited-list">
            <p class="mla-hanging-indent">
              {studentEssayCitation}
            </p>
            {entry.worksCitedMLA.map((citation) => (
              <p class="mla-hanging-indent">{citation}</p>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Sidebar: Author & Quick Navigation -->
      <aside class="entry-sidebar" aria-label="Entry Metadata and Quick Jump">
        <div class="feature-card sidebar-card">
          <span class="caption-uppercase sidebar-card__heading">Author Attribution</span>
          <p class="title-sm sidebar-card__name">Shawn Shaibu Cherian</p>
          <p class="caption">Reg. No. 26BCE1820</p>
          <p class="caption">Vellore Institute of Technology (VIT), Chennai</p>
          <hr class="sidebar-divider" />
          <span class="caption-uppercase sidebar-card__heading">How to Edit This Entry</span>
          <p class="body-sm sidebar-card__note">
            Open <code>src/content/essays/{entry.slug}.md</code> to write your essay sections, or update <code>src/data/entries.ts</code> for Critical Lens notes.
          </p>
          <div class="sidebar-card__actions">
            <a href={withBase('/about/#edit-guide')} class="button-outline sidebar-btn">
              Full Editing Guide
            </a>
            <a href={withBase('/blackout/')} class="button-outline sidebar-btn">
              Blackout Studio
            </a>
          </div>
        </div>

        <div class="feature-card sidebar-card">
          <span class="caption-uppercase sidebar-card__heading">All 5 Cornerstone Entries</span>
          <ul class="sidebar-entry-list">
            {ESSAY_ENTRIES.map((item) => (
              <li>
                <a
                  href={withBase(`/entries/${item.slug}/`)}
                  class:list={['sidebar-entry-link', { 'is-current': item.slug === entry.slug }]}
                >
                  <span class="sidebar-entry-num">{item.number}</span>
                  <span>{item.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- 5. PREVIOUS / NEXT ENTRY NAVIGATION CARDS -->
  <section class="section-band section-band--soft entry-pager" aria-label="Entry Pagination">
    <div class="container">
      <div class="pager-grid">
        <a href={withBase(`/entries/${prevEntry.slug}/`)} class="feature-card pager-card">
          <span class="caption-uppercase pager-card__dir">← Previous Entry ({prevEntry.number})</span>
          <span class="display-sm pager-card__title">{prevEntry.title}</span>
          <span class="caption">{prevEntry.era}</span>
        </a>

        <a href={withBase(`/entries/${nextEntry.slug}/`)} class="feature-card pager-card pager-card--next">
          <span class="caption-uppercase pager-card__dir">Next Entry ({nextEntry.number}) →</span>
          <span class="display-sm pager-card__title">{nextEntry.title}</span>
          <span class="caption">{nextEntry.era}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // 1. CRITICAL LENS SWITCH CONTROLLER (Global + Per-Passage)
  function initCriticalLens() {
    const globalSwitch = document.getElementById('global-lens-switch');
    const globalStateLabel = document.getElementById('global-lens-state-label');
    const lensCards = Array.from(document.querySelectorAll<HTMLElement>('[data-lens-card]'));

    function setCardMode(card: HTMLElement, mode: 'surface' | 'subtext') {
      const surfacePane = card.querySelector<HTMLElement>('[data-lens-pane="surface"]');
      const subtextPane = card.querySelector<HTMLElement>('[data-lens-pane="subtext"]');
      const surfaceBtn = card.querySelector<HTMLButtonElement>('[data-lens-tab="surface"]');
      const subtextBtn = card.querySelector<HTMLButtonElement>('[data-lens-tab="subtext"]');

      if (!surfacePane || !subtextPane || !surfaceBtn || !subtextBtn) return;

      const isSubtext = mode === 'subtext';
      surfacePane.hidden = isSubtext;
      subtextPane.hidden = !isSubtext;

      surfaceBtn.classList.toggle('is-active', !isSubtext);
      surfaceBtn.setAttribute('aria-pressed', String(!isSubtext));

      subtextBtn.classList.toggle('is-active', isSubtext);
      subtextBtn.setAttribute('aria-pressed', String(isSubtext));
    }

    function setGlobalMode(mode: 'surface' | 'subtext') {
      const isSubtext = mode === 'subtext';
      if (globalSwitch) {
        globalSwitch.setAttribute('aria-checked', String(isSubtext));
        const surfOpt = globalSwitch.querySelector('[data-lens-opt="surface"]');
        const subOpt = globalSwitch.querySelector('[data-lens-opt="subtext"]');
        surfOpt?.classList.toggle('is-selected', !isSubtext);
        subOpt?.classList.toggle('is-selected', isSubtext);
      }
      if (globalStateLabel) {
        globalStateLabel.textContent = isSubtext ? 'Critical Lens (Subtext)' : 'Surface Text';
      }
      lensCards.forEach((card) => setCardMode(card, mode));
    }

    if (globalSwitch) {
      globalSwitch.addEventListener('click', () => {
        const checked = globalSwitch.getAttribute('aria-checked') === 'true';
        setGlobalMode(checked ? 'surface' : 'subtext');
      });
    }

    lensCards.forEach((card) => {
      const surfaceBtn = card.querySelector<HTMLButtonElement>('[data-lens-tab="surface"]');
      const subtextBtn = card.querySelector<HTMLButtonElement>('[data-lens-tab="subtext"]');

      surfaceBtn?.addEventListener('click', () => setCardMode(card, 'surface'));
      subtextBtn?.addEventListener('click', () => setCardMode(card, 'subtext'));
    });
  }

  // 2. MLA CITATION COPY CONTROLLER
  function initCitationCopy() {
    const copyBtn = document.getElementById('copy-mla-btn');
    const copyLabel = document.getElementById('copy-mla-label');
    if (!copyBtn || !copyLabel) return;

    copyBtn.addEventListener('click', async () => {
      const citations = copyBtn.getAttribute('data-citations') || '';
      try {
        await navigator.clipboard.writeText(citations);
        copyLabel.textContent = 'Copied MLA 9th to Clipboard';
        setTimeout(() => {
          copyLabel.textContent = 'Copy MLA Citations';
        }, 2400);
      } catch {
        copyLabel.textContent = 'Select Text Below to Copy';
      }
    });
  }

  // 3. ELEVENLABS WEB SPEECH API READ-ALOUD CONTROLLER
  function initVoicePlayer() {
    const playBtn = document.getElementById('voice-play-btn') as HTMLButtonElement | null;
    const stopBtn = document.getElementById('voice-stop-btn') as HTMLButtonElement | null;
    const playLabel = document.getElementById('voice-play-label');
    const statusBadge = document.getElementById('voice-status-badge');
    const progressLabel = document.getElementById('voice-progress-label');
    const waveform = document.getElementById('voice-waveform');
    const voiceSelect = document.getElementById('voice-selector') as HTMLSelectElement | null;
    const fallbackMsg = document.getElementById('voice-fallback-msg');
    const speedBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-speech-rate]'));

    if (!('speechSynthesis' in window) || typeof SpeechSynthesisUtterance === 'undefined') {
      if (fallbackMsg) fallbackMsg.hidden = false;
      if (playBtn) playBtn.disabled = true;
      if (statusBadge) statusBadge.textContent = 'Unsupported';
      return;
    }

    const synth = window.speechSynthesis;
    let voices: SpeechSynthesisVoice[] = [];
    let currentRate = 1;
    let isPlaying = false;
    let isPaused = false;
    let currentSegmentIndex = 0;
    let segments: HTMLElement[] = [];

    function populateVoices() {
      voices = synth.getVoices();
      if (!voiceSelect || voices.length === 0) return;
      const currentVal = voiceSelect.value;
      voiceSelect.innerHTML = '<option value="">Default System Editorial Voice</option>';
      voices
        .filter((v) => v.lang.startsWith('en'))
        .forEach((voice) => {
          const opt = document.createElement('option');
          opt.value = voice.name;
          opt.textContent = `${voice.name} (${voice.lang})`;
          voiceSelect.appendChild(opt);
        });
      if (currentVal) voiceSelect.value = currentVal;
    }

    populateVoices();
    if (synth.onvoiceschanged !== undefined) {
      synth.onvoiceschanged = populateVoices;
    }

    function collectSegments(): HTMLElement[] {
      const container = document.getElementById('readable-essay-container');
      if (!container) return [];
      return Array.from(container.querySelectorAll<HTMLElement>('[data-speech-segment]'));
    }

    function clearHighlights() {
      document.querySelectorAll('.is-speaking-active').forEach((el) => {
        el.classList.remove('is-speaking-active');
      });
    }

    function updateUI(state: 'idle' | 'playing' | 'paused') {
      isPlaying = state === 'playing';
      isPaused = state === 'paused';

      if (waveform) {
        waveform.setAttribute('data-playing', state === 'playing' ? 'true' : 'false');
      }
      if (stopBtn) {
        stopBtn.disabled = state === 'idle';
      }
      if (playLabel) {
        playLabel.textContent =
          state === 'playing' ? 'Pause Read-Aloud' : state === 'paused' ? 'Resume Read-Aloud' : 'Listen to Entry';
      }
      if (statusBadge) {
        statusBadge.textContent =
          state === 'playing' ? 'Speaking' : state === 'paused' ? 'Paused' : 'Ready';
      }
      if (state === 'idle') {
        clearHighlights();
        if (progressLabel) {
          progressLabel.textContent =
            'Reads the entry abstract, essay sections, and active Critical Lens passages aloud via Web Speech synthesis.';
        }
      }
    }

    function speakSegment(index: number) {
      if (index >= segments.length) {
        synth.cancel();
        currentSegmentIndex = 0;
        updateUI('idle');
        return;
      }

      currentSegmentIndex = index;
      const targetEl = segments[index];
      clearHighlights();
      targetEl.classList.add('is-speaking-active');

      const segLabel = targetEl.getAttribute('data-speech-segment') || `Section ${index + 1}`;
      if (progressLabel) {
        progressLabel.textContent = `Reading ${index + 1} of ${segments.length}: ${segLabel}`;
      }

      const textToRead = (targetEl.innerText || targetEl.textContent || '').replace(/\s+/g, ' ').trim();
      if (!textToRead) {
        speakSegment(index + 1);
        return;
      }

      const utterance = new SpeechSynthesisUtterance(textToRead);
      utterance.rate = currentRate;

      if (voiceSelect && voiceSelect.value) {
        const chosen = voices.find((v) => v.name === voiceSelect.value);
        if (chosen) utterance.voice = chosen;
      }

      utterance.onend = () => {
        if (isPlaying && !isPaused) {
          speakSegment(index + 1);
        }
      };

      utterance.onerror = () => {
        updateUI('idle');
      };

      synth.speak(utterance);
    }

    playBtn?.addEventListener('click', () => {
      if (isPlaying) {
        synth.pause();
        updateUI('paused');
        return;
      }
      if (isPaused) {
        synth.resume();
        updateUI('playing');
        return;
      }
      synth.cancel();
      segments = collectSegments();
      if (segments.length === 0) return;
      updateUI('playing');
      speakSegment(0);
    });

    stopBtn?.addEventListener('click', () => {
      synth.cancel();
      currentSegmentIndex = 0;
      updateUI('idle');
    });

    speedBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const rate = parseFloat(btn.getAttribute('data-speech-rate') || '1');
        currentRate = rate;
        speedBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (isPlaying) {
          synth.cancel();
          speakSegment(currentSegmentIndex);
        }
      });
    });

    const cleanupSpeech = () => {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
    };

    window.addEventListener('pagehide', cleanupSpeech);
    window.addEventListener('beforeunload', cleanupSpeech);
  }

  initCriticalLens();
  initCitationCopy();
  initVoicePlayer();
</script>

