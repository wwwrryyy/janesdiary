---
import { withBase } from '../lib/url';
import { ESSAY_ENTRIES } from '../data/entries';
---

<footer class="site-footer no-print" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Column 1: Brand & Masthead -->
      <div class="site-footer__col site-footer__col--brand">
        <a href={withBase('/')} class="site-footer__wordmark">Jane’s Diary</a>
        <p class="site-footer__desc">
          An independent journal &amp; digital archive of feminist literature—scraping back canonical erasures from Romantic proto-feminism to postcolonial subaltern studies and cyberfeminism.
        </p>
        <div class="site-footer__masthead-box">
          <span class="badge-pill">Independent Journal</span>
          <p class="site-footer__masthead-name">Shawn Shaibu Cherian</p>
          <p class="site-footer__masthead-meta">Founding Editor &amp; Essayist</p>
        </div>
      </div>

      <!-- Column 2: Essays 01–04 -->
      <div class="site-footer__col">
        <h3 class="caption-uppercase site-footer__heading">Essays 01 – 04</h3>
        <ul class="site-footer__list">
          {ESSAY_ENTRIES.slice(0, 4).map((entry) => (
            <li>
              <a href={withBase(`/entries/${entry.slug}/`)} class="footer-link">
                <span class="site-footer__num">{entry.number}.</span> {entry.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Essays 05–08 -->
      <div class="site-footer__col">
        <h3 class="caption-uppercase site-footer__heading">Essays 05 – 08</h3>
        <ul class="site-footer__list">
          {ESSAY_ENTRIES.slice(4, 8).map((entry) => (
            <li>
              <a href={withBase(`/entries/${entry.slug}/`)} class="footer-link">
                <span class="site-footer__num">{entry.number}.</span> {entry.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Archive & Syllabi -->
      <div class="site-footer__col">
        <h3 class="caption-uppercase site-footer__heading">Archive &amp; Syllabi</h3>
        <ul class="site-footer__list">
          <li>
            <a href={withBase('/blogs/')} class="footer-link">
              All 8 Thematic Subsections
            </a>
          </li>
          <li>
            <a href={withBase('/archive/')} class="footer-link">
              The Palimpsest Archive (Facsimiles)
            </a>
          </li>
          <li>
            <a href={withBase('/syllabus/')} class="footer-link">
              Curated Seminar Syllabi
            </a>
          </li>
          <li>
            <a href={withBase('/#bylines')} class="footer-link">
              Historical Pseudonym Decoder
            </a>
          </li>
          <li>
            <a href={withBase('/about/#bibliography')} class="footer-link">
              Master Scholarly References
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 5: Journal & Commissions -->
      <div class="site-footer__col">
        <h3 class="caption-uppercase site-footer__heading">Journal &amp; Inquiries</h3>
        <ul class="site-footer__list">
          <li>
            <a href={withBase('/about/')} class="footer-link">
              Publication Manifesto
            </a>
          </li>
          <li>
            <a href={withBase('/about/#services-heading')} class="footer-link">
              Commissions &amp; Lectures
            </a>
          </li>
          <li>
            <a href={withBase('/contact/')} class="footer-link">
              Contact Editorial Desk
            </a>
          </li>
          <li>
            <a href="mailto:shawnsc76@gmail.com" class="footer-link">
              shawnsc76@gmail.com ✉
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="caption">
        © {new Date().getFullYear()} Jane’s Diary. Edited &amp; published by Shawn Shaibu Cherian. All rights reserved.
      </p>
      <div class="site-footer__bottom-links">
        <a href={withBase('/')} class="footer-link">Home</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/blogs/')} class="footer-link">Essays</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/archive/')} class="footer-link">Archive</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/syllabus/')} class="footer-link">Syllabus</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/about/')} class="footer-link">About</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/contact/')} class="footer-link">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-canvas);
    color: var(--color-body);
    border-top: 1px solid var(--color-hairline);
    padding: 64px 0 48px;
    font-size: 15px;
    line-height: 1.47;
    letter-spacing: 0.15px;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: var(--space-xl);
    padding-bottom: var(--space-xxl);
    border-bottom: 1px solid var(--color-hairline);
  }

  .site-footer__wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 300;
    line-height: 1.1;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
  }

  .site-footer__desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.55;
    margin-bottom: var(--space-base);
  }

  .site-footer__masthead-box {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-base);
  }

  .site-footer__masthead-name {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    margin-top: var(--space-xs);
  }

  .site-footer__masthead-meta {
    font-size: 13px;
    color: var(--color-muted);
  }

  .site-footer__heading {
    color: var(--color-ink);
    margin-bottom: var(--space-base);
  }

  .site-footer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .site-footer__num {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .footer-link {
    background-color: transparent;
    color: var(--color-body);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-ink);
  }

  .site-footer__bottom {
    padding-top: var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-base);
  }

  .site-footer__bottom-links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  @media (max-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .site-footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 48px 0 32px;
    }
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
