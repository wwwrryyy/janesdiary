---
import { withBase } from '../lib/url';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="top-nav" role="banner">
  <div class="container top-nav__inner">
    <div class="top-nav__brand">
      <a href={withBase('/')} class="top-nav__wordmark" aria-label="Jane's Diary Home">
        Jane’s Diary
      </a>
      <a href={withBase('/about/')} class="badge-pill top-nav__reg" title="Shawn Shaibu Cherian · Reg. No. 26BCE1820 · VIT Chennai">
        <span class="badge-dot badge-dot--mint" aria-hidden="true"></span>
        26BCE1820
      </a>
    </div>

    <nav class="top-nav__menu" aria-label="Primary Navigation">
      <a
        href={withBase('/#entries')}
        class:list={['top-nav__link', { 'is-active': currentPath.startsWith('/entries') }]}
      >
        Entries
      </a>
      <a
        href={withBase('/#bylines')}
        class="top-nav__link"
      >
        Byline Archive
      </a>
      <a
        href={withBase('/blackout/')}
        class:list={['top-nav__link', { 'is-active': currentPath.startsWith('/blackout') }]}
      >
        Blackout Studio
      </a>
      <a
        href={withBase('/about/')}
        class:list={['top-nav__link', { 'is-active': currentPath.startsWith('/about') }]}
      >
        About &amp; Rubric
      </a>
    </nav>

    <div class="top-nav__actions">
      <a href={withBase('/about/#edit-guide')} class="button-outline top-nav__guide-btn">
        Write / Edit Guide
      </a>
      <a href={withBase('/#entries')} class="button-primary top-nav__cta">
        Explore Entries
      </a>
      <button
        type="button"
        class="top-nav__hamburger"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Toggle navigation menu"
      >
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5.5H17M3 10H17M3 14.5H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-drawer" id="mobile-nav-drawer" hidden>
    <div class="container mobile-drawer__inner">
      <div class="mobile-drawer__meta">
        <span class="caption">Shawn Shaibu Cherian · Reg. No. 26BCE1820 · VIT Chennai</span>
      </div>
      <nav class="mobile-drawer__links" aria-label="Mobile Navigation">
        <a href={withBase('/#entries')} class="mobile-drawer__link">The 5 Cornerstone Entries</a>
        <a href={withBase('/#bylines')} class="mobile-drawer__link">“By a Lady” Byline Archive</a>
        <a href={withBase('/blackout/')} class="mobile-drawer__link">Blackout Poetry Studio</a>
        <a href={withBase('/about/')} class="mobile-drawer__link">About &amp; DA Rubric</a>
        <a href={withBase('/about/#edit-guide')} class="mobile-drawer__link">How to Fill In Your Essays</a>
      </nav>
      <div class="mobile-drawer__actions">
        <a href={withBase('/#entries')} class="button-primary">Explore All 5 Entries</a>
        <a href={withBase('/blackout/')} class="button-outline">Open Blackout Studio</a>
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileNav() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!toggleBtn || !drawer) return;

    const closeDrawer = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      drawer.hidden = true;
    };

    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      drawer.hidden = expanded;
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) {
        closeDrawer();
        toggleBtn.focus();
      }
    });
  }

  initMobileNav();
</script>

<style>
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(245, 245, 245, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-ink);
  }

  .top-nav__inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-base);
  }

  .top-nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .top-nav__wordmark {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.32px;
    color: var(--color-ink);
  }

  .top-nav__reg {
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .top-nav__reg:hover {
    background-color: var(--color-hairline);
  }

  .top-nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .top-nav__link {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-body);
    padding: 6px 2px;
    position: relative;
    transition: color 0.15s ease;
  }

  .top-nav__link:hover,
  .top-nav__link.is-active {
    color: var(--color-ink);
  }

  .top-nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background-color: var(--color-ink);
    border-radius: var(--radius-pill);
  }

  .top-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .top-nav__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline-strong);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .top-nav__hamburger .icon-close {
    display: none;
  }

  .top-nav__hamburger[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .top-nav__hamburger[aria-expanded='true'] .icon-close {
    display: block;
  }

  .mobile-drawer {
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline-strong);
    padding: var(--space-lg) 0;
  }

  .mobile-drawer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-base);
  }

  .mobile-drawer__meta {
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-hairline);
  }

  .mobile-drawer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .mobile-drawer__link {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
    padding: 8px 0;
    border-bottom: 1px solid var(--color-hairline-soft);
  }

  .mobile-drawer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-xs);
  }

  @media (max-width: 960px) {
    .top-nav__guide-btn {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .top-nav__menu,
    .top-nav__cta {
      display: none;
    }
    .top-nav__hamburger {
      display: inline-flex;
    }
  }
</style>
